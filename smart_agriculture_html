<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Agriculture Monitoring System - Enhanced</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #333;
            padding: 20px;
        }
        
        .container {
            max-width: 1600px;
            margin: 0 auto;
        }
        
        header {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            text-align: center;
        }
        
        h1 {
            color: #667eea;
            font-size: 2em;
            margin-bottom: 10px;
        }
        
        .subtitle {
            color: #666;
            font-size: 1.1em;
        }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        .card h2 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.3em;
            border-bottom: 2px solid #667eea;
            padding-bottom: 10px;
        }
        
        .video-container {
            grid-column: 1 / -1;
            position: relative;
            background: #000;
            border-radius: 10px;
            overflow: hidden;
        }
        
        #videoFeed {
            width: 100%;
            height: auto;
            display: block;
        }
        
        .status-item {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            margin: 5px 0;
            background: #f8f9fa;
            border-radius: 5px;
        }
        
        .status-label {
            font-weight: bold;
            color: #555;
        }
        
        .status-value {
            color: #667eea;
            font-weight: bold;
        }
        
        .status-value.active {
            color: #28a745;
        }
        
        .status-value.inactive {
            color: #dc3545;
        }
        
        .status-value.warning {
            color: #ff9800;
            animation: pulse 1s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
            font-weight: bold;
            transition: all 0.3s;
            margin: 5px;
            width: calc(100% - 10px);
        }
        
        .btn-primary {
            background: #667eea;
            color: white;
        }
        
        .btn-primary:hover {
            background: #5568d3;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(102, 126, 234, 0.3);
        }
        
        .btn-success {
            background: #28a745;
            color: white;
        }
        
        .btn-success:hover {
            background: #218838;
        }
        
        .btn-warning {
            background: #ffc107;
            color: #333;
        }
        
        .btn-warning:hover {
            background: #e0a800;
        }
        
        .btn-danger {
            background: #dc3545;
            color: white;
        }
        
        .btn-danger:hover {
            background: #c82333;
        }
        
        .btn-info {
            background: #17a2b8;
            color: white;
        }
        
        .btn-info:hover {
            background: #138496;
        }
        
        .slider-container {
            margin: 15px 0;
        }
        
        .slider {
            width: 100%;
            height: 8px;
            border-radius: 5px;
            background: #ddd;
            outline: none;
            margin: 10px 0;
        }
        
        .slider::-webkit-slider-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #667eea;
            cursor: pointer;
        }
        
        .input-group {
            margin: 10px 0;
        }
        
        .input-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }
        
        .input-group input {
            width: 100%;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
        }
        
        .logs-container {
            max-height: 300px;
            overflow-y: auto;
            background: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
            font-family: monospace;
            font-size: 0.9em;
        }
        
        .log-entry {
            padding: 5px;
            border-bottom: 1px solid #ddd;
        }
        
        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 0.9em;
            font-weight: bold;
            margin: 5px;
        }
        
        .badge-success {
            background: #28a745;
            color: white;
        }
        
        .badge-warning {
            background: #ffc107;
            color: #333;
        }
        
        .badge-danger {
            background: #dc3545;
            color: white;
        }
        
        .badge-info {
            background: #17a2b8;
            color: white;
        }
        
        #analysisResult {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-top: 10px;
            white-space: pre-wrap;
            max-height: 400px;
            overflow-y: auto;
        }
        
        .loading {
            text-align: center;
            padding: 20px;
            color: #667eea;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #667eea;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }
        
        .arm-control {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        
        .servo-control {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
        }
        
        .servo-label {
            font-size: 0.9em;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .alert {
            padding: 15px;
            border-radius: 5px;
            margin: 10px 0;
            font-weight: bold;
        }
        
        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 2px solid #f5c6cb;
        }
        
        .alert-warning {
            background: #fff3cd;
            color: #856404;
            border: 2px solid #ffeeba;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🌱 Smart Agriculture Monitoring System - Enhanced</h1>
            <p class="subtitle">Real-time Disease Detection • Automated Treatment • Security Monitoring</p>
        </header>

        <!-- Alerts -->
        <div id="alertsContainer"></div>

        <!-- Live Camera Feed -->
        <div class="grid">
            <div class="card video-container">
                <img id="videoFeed" src="/video_feed" alt="Live Camera Feed">
            </div>
        </div>

        <!-- Main Grid -->
        <div class="grid">
            <!-- System Status -->
            <div class="card">
                <h2>📊 System Status</h2>
                <div class="status-item">
                    <span class="status-label">Auto Mode:</span>
                    <span class="status-value" id="autoMode">-</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Detection Count:</span>
                    <span class="status-value" id="detectionCount">0</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Soil Moisture:</span>
                    <span class="status-value" id="soilMoisture">-</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Box Status:</span>
                    <span class="status-value" id="boxStatus">-</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Relay Switch 2:</span>
                    <span class="status-value" id="relaySwitch2">-</span>
                </div>
                <button class="btn btn-primary" onclick="toggleAutoMode()">Toggle Auto Mode</button>
            </div>

            <!-- Security Sensors -->
            <div class="card">
                <h2>🔒 Security Sensors</h2>
                <div class="status-item">
                    <span class="status-label">👁️ Motion (PIR):</span>
                    <span class="status-value" id="motionStatus">-</span>
                </div>
                <div class="status-item">
                    <span class="status-label">💨 Smoke (MQ2):</span>
                    <span class="status-value" id="smokeStatus">-</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Motion Events Today:</span>
                    <span class="status-value" id="motionEvents">0</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Smoke Alerts Today:</span>
                    <span class="status-value" id="smokeAlerts">0</span>
                </div>
                <button class="btn btn-warning" onclick="testAlarm()">🔔 Test Alarm</button>
                <button class="btn btn-info" onclick="sendBeep()">🔊 Beep</button>
            </div>

            <!-- Manual Controls -->
            <div class="card">
                <h2>🎮 Manual Controls</h2>
                
                <div class="input-group">
                    <label>Fertilizer Spray (seconds):</label>
                    <input type="number" id="fertilizerDuration" value="30" min="5" max="120">
                </div>
                <button class="btn btn-success" onclick="sprayFertilizer()">💧 Spray Fertilizer</button>
                
                <div class="input-group">
                    <label>Water Spray (seconds):</label>
                    <input type="number" id="waterDuration" value="30" min="5" max="120">
                </div>
                <button class="btn btn-info" onclick="sprayWater()">💦 Spray Water</button>
                
                <div class="input-group">
                    <label>UV Light (seconds):</label>
                    <input type="number" id="uvDuration" value="180" min="30" max="600">
                </div>
                <button class="btn btn-warning" onclick="activateUVLight()">💡 Activate UV Light</button>
                
                <button class="btn btn-primary" onclick="checkSoil()">🌱 Check Soil Moisture</button>
            </div>

            <!-- Box Control -->
            <div class="card">
                <h2>📦 Box Control</h2>
                <div class="status-item">
                    <span class="status-label">Current Status:</span>
                    <span class="status-value" id="boxCurrentStatus">Closed</span>
                </div>
                <button class="btn btn-success" onclick="controlBox(true)">📂 Open Box</button>
                <button class="btn btn-danger" onclick="controlBox(false)">📁 Close Box</button>
            </div>

            <!-- Soil Sensor Servo -->
            <div class="card">
                <h2>🔧 Soil Sensor Servo</h2>
                <div class="slider-container">
                    <label>Servo Angle: <span id="servoAngle">0</span>°</label>
                    <input type="range" class="slider" id="servoSlider" min="0" max="180" value="0" oninput="updateServoDisplay(this.value)">
                </div>
                <button class="btn btn-primary" onclick="setServoAngle()">Set Position</button>
                <div class="status-item">
                    <span class="status-label">Current:</span>
                    <span class="status-value" id="currentServo">0°</span>
                </div>
            </div>

            <!-- LSC-6 Robotic Arm Control -->
            <div class="card" style="grid-column: 1 / -1;">
                <h2>🦾 LSC-6 Robotic Arm Control</h2>
                <div class="status-item">
                    <span class="status-label">Connection Status:</span>
                    <span class="status-value" id="lsc6Status">-</span>
                </div>
                
                <div class="arm-control">
                    <div class="servo-control">
                        <div class="servo-label">Servo 1 (Base): <span id="s1Val">1500</span></div>
                        <input type="range" class="slider" id="s1" min="500" max="2500" value="1500" 
                               oninput="updateServoValue(1, this.value)">
                    </div>
                    <div class="servo-control">
                        <div class="servo-label">Servo 2 (Shoulder): <span id="s2Val">1500</span></div>
                        <input type="range" class="slider" id="s2" min="500" max="2500" value="1500"
                               oninput="updateServoValue(2, this.value)">
                    </div>
                    <div class="servo-control">
                        <div class="servo-label">Servo 3 (Elbow): <span id="s3Val">1500</span></div>
                        <input type="range" class="slider" id="s3" min="500" max="2500" value="1500"
                               oninput="updateServoValue(3, this.value)">
                    </div>
                    <div class="servo-control">
                        <div class="servo-label">Servo 4 (Wrist): <span id="s4Val">1500</span></div>
                        <input type="range" class="slider" id="s4" min="500" max="2500" value="1500"
                               oninput="updateServoValue(4, this.value)">
                    </div>
                    <div class="servo-control">
                        <div class="servo-label">Servo 5 (Rotate): <span id="s5Val">1500</span></div>
                        <input type="range" class="slider" id="s5" min="500" max="2500" value="1500"
                               oninput="updateServoValue(5, this.value)">
                    </div>
                    <div class="servo-control">
                        <div class="servo-label">Servo 6 (Gripper): <span id="s6Val">1500</span></div>
                        <input type="range" class="slider" id="s6" min="500" max="2500" value="1500"
                               oninput="updateServoValue(6, this.value)">
                    </div>
                </div>
                
                <div style="margin-top: 15px;">
                    <button class="btn btn-success" onclick="resetArm()">🏠 Reset to Center</button>
                    <div class="input-group">
                        <label>Movement Speed (500-3000):</label>
                        <input type="number" id="armSpeed" value="1000" min="500" max="3000">
                    </div>
                </div>
            </div>

            <!-- Online AI Analysis -->
            <div class="card">
                <h2>🤖 AI Analysis</h2>
                <p style="color: #666; margin-bottom: 10px;">Get detailed analysis using Google Gemini AI</p>
                <button class="btn btn-primary" onclick="getGeminiAnalysis()">🔍 Get AI Analysis</button>
                <div id="analysisResult"></div>
            </div>

            <!-- Daily Report -->
            <div class="card">
                <h2>📋 Daily Report</h2>
                <div class="status-item">
                    <span class="status-label">Date:</span>
                    <span class="status-value" id="reportDate">-</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Total Detections:</span>
                    <span class="status-value" id="totalDetections">0</span>
                </div>
                <div id="diseasesList" style="margin: 10px 0;"></div>
                <button class="btn btn-success" onclick="downloadReport()">📥 Download Report</button>
                <button class="btn btn-info" onclick="updateReport()">🔄 Refresh</button>
            </div>

            <!-- System Logs -->
            <div class="card" style="grid-column: 1 / -1;">
                <h2>📝 System Logs</h2>
                <div class="logs-container" id="systemLogs">
                    <div class="loading">Loading logs...</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Update status every 2 seconds
        setInterval(updateStatus, 2000);
        setInterval(updateReport, 30000);
        
        // Initial updates
        updateStatus();
        updateReport();

        function updateStatus() {
            fetch('/api/status')
                .then(response => response.json())
                .then(data => {
                    // System status
                    document.getElementById('autoMode').textContent = data.auto_mode ? 'Enabled' : 'Disabled';
                    document.getElementById('autoMode').className = data.auto_mode ? 'status-value active' : 'status-value inactive';
                    
                    document.getElementById('detectionCount').textContent = data.detection_count;
                    document.getElementById('soilMoisture').textContent = data.soil_moisture ? data.soil_moisture + '%' : 'Not available';
                    document.getElementById('currentServo').textContent = data.servo_position + '°';
                    
                    // Box status
                    document.getElementById('boxStatus').textContent = data.box_open ? 'Open' : 'Closed';
                    document.getElementById('boxStatus').className = data.box_open ? 'status-value active' : 'status-value inactive';
                    document.getElementById('boxCurrentStatus').textContent = data.box_open ? 'Open' : 'Closed';
                    
                    // Relay switch 2
                    document.getElementById('relaySwitch2').textContent = data.relay_switch_2 ? 'ON' : 'OFF';
                    document.getElementById('relaySwitch2').className = data.relay_switch_2 ? 'status-value active' : 'status-value inactive';
                    
                    // Security sensors
                    const motionEl = document.getElementById('motionStatus');
                    motionEl.textContent = data.motion_detected ? '⚠️ DETECTED' : '✅ Clear';
                    motionEl.className = data.motion_detected ? 'status-value warning' : 'status-value active';
                    
                    const smokeEl = document.getElementById('smokeStatus');
                    smokeEl.textContent = data.smoke_detected ? '🔥 DETECTED!' : '✅ Clear';
                    smokeEl.className = data.smoke_detected ? 'status-value warning' : 'status-value active';
                    
                    // LSC-6 status
                    document.getElementById('lsc6Status').textContent = data.lsc6_connected ? 'Connected' : 'Not Connected';
                    document.getElementById('lsc6Status').className = data.lsc6_connected ? 'status-value active' : 'status-value inactive';
                    
                    // Update LSC-6 servo displays
                    if (data.lsc6_positions) {
                        for (let i = 0; i < 6; i++) {
                            document.getElementById(`s${i+1}`).value = data.lsc6_positions[i];
                            document.getElementById(`s${i+1}Val`).textContent = data.lsc6_positions[i];
                        }
                    }
                    
                    // Update alerts
                    updateAlerts(data);
                    
                    // Update logs
                    const logsContainer = document.getElementById('systemLogs');
                    logsContainer.innerHTML = data.system_logs.map(log => 
                        `<div class="log-entry">${log}</div>`
                    ).join('');
                });
        }

        function updateAlerts(data) {
            const alertsContainer = document.getElementById('alertsContainer');
            let alerts = '';
            
            if (data.smoke_detected) {
                alerts += '<div class="alert alert-danger">🔥 SMOKE DETECTED! Alarm activated!</div>';
            }
            
            if (data.motion_detected) {
                alerts += '<div class="alert alert-warning">👁️ Motion detected - Relay Switch 2 deactivated</div>';
            }
            
            alertsContainer.innerHTML = alerts;
        }

        function updateReport() {
            fetch('/api/daily_report')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('reportDate').textContent = data.date;
                    document.getElementById('totalDetections').textContent = data.total_detections;
                    document.getElementById('motionEvents').textContent = data.motion_events || 0;
                    document.getElementById('smokeAlerts').textContent = data.smoke_alerts || 0;
                    
                    const diseasesList = document.getElementById('diseasesList');
                    if (data.diseases_found.length > 0) {
                        diseasesList.innerHTML = '<strong>Diseases Found:</strong><br>' + 
                            data.diseases_found.map(d => 
                                `<span class="badge badge-danger">${d}</span>`
                            ).join('');
                    } else {
                        diseasesList.innerHTML = '<span class="badge badge-success">No diseases detected</span>';
                    }
                });
        }

        function sendControl(action, data = {}) {
            fetch('/api/control', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({action: action, ...data})
            })
            .then(response => response.json())
            .then(data => {
                console.log('Control:', action);
                updateStatus();
            });
        }

        function toggleAutoMode() {
            sendControl('toggle_auto');
        }

        function sprayFertilizer() {
            const duration = parseInt(document.getElementById('fertilizerDuration').value);
            if (confirm(`Spray fertilizer for ${duration} seconds?`)) {
                sendControl('fertilizer', {duration: duration});
            }
        }

        function sprayWater() {
            const duration = parseInt(document.getElementById('waterDuration').value);
            if (confirm(`Spray water for ${duration} seconds?`)) {
                sendControl('water', {duration: duration});
            }
        }

        function activateUVLight() {
            const duration = parseInt(document.getElementById('uvDuration').value);
            if (confirm(`Activate UV light for ${duration} seconds?`)) {
                sendControl('uv_light', {duration: duration});
            }
        }

        function checkSoil() {
            sendControl('soil_check');
        }

        function controlBox(open) {
            sendControl('box', {open: open});
        }

        function sendBeep() {
            sendControl('beep');
        }

        function testAlarm() {
            if (confirm('Test alarm? This will make noise!')) {
                sendControl('alarm');
            }
        }

        function updateServoDisplay(value) {
            document.getElementById('servoAngle').textContent = value;
        }

        function setServoAngle() {
            const angle = parseInt(document.getElementById('servoSlider').value);
            sendControl('servo', {angle: angle});
        }

        function updateServoValue(servoId, value) {
            document.getElementById(`s${servoId}Val`).textContent = value;
            const speed = parseInt(document.getElementById('armSpeed').value);
            sendControl('lsc6_servo', {
                servo_id: servoId,
                position: parseInt(value),
                speed: speed
            });
        }

        function resetArm() {
            sendControl('lsc6_reset');
            // Reset UI sliders
            for (let i = 1; i <= 6; i++) {
                document.getElementById(`s${i}`).value = 1500;
                document.getElementById(`s${i}Val`).textContent = 1500;
            }
        }

        function getGeminiAnalysis() {
            const resultDiv = document.getElementById('analysisResult');
            resultDiv.innerHTML = '<div class="loading"><div class="spinner"></div>Analyzing...</div>';
            
            fetch('/api/gemini_analysis', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'}
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    resultDiv.innerHTML = `<div style="color: red;">Error: ${data.error}</div>`;
                } else {
                    resultDiv.innerHTML = data.analysis;
                }
            })
            .catch(error => {
                resultDiv.innerHTML = '<div style="color: red;">Analysis failed.</div>';
            });
        }

        function downloadReport() {
            window.location.href = '/api/download_report';
        }
    </script>
</body>
</html>
