<svg viewBox="0 0 1400 2400" xmlns="http://www.w3.org/2000/svg">
  <!-- Define styles -->
  <defs>
    <style>
      .start-end { fill: #4CAF50; stroke: #2E7D32; stroke-width: 3; }
      .process { fill: #2196F3; stroke: #1565C0; stroke-width: 2; }
      .decision { fill: #FF9800; stroke: #E65100; stroke-width: 2; }
      .io { fill: #9C27B0; stroke: #6A1B9A; stroke-width: 2; }
      .sensor { fill: #00BCD4; stroke: #006064; stroke-width: 2; }
      .action { fill: #F44336; stroke: #B71C1C; stroke-width: 2; }
      .text { fill: white; font-family: Arial, sans-serif; font-size: 13px; text-anchor: middle; }
      .title { fill: #1a237e; font-family: Arial, sans-serif; font-size: 24px; font-weight: bold; text-anchor: middle; }
      .subtitle { fill: #424242; font-family: Arial, sans-serif; font-size: 14px; text-anchor: middle; }
      .arrow { stroke: #333; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
      .label { fill: #333; font-family: Arial, sans-serif; font-size: 12px; }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#333" />
    </marker>
  </defs>

  <!-- Title -->
  <text x="700" y="30" class="title">SMART AGRICULTURE MONITORING SYSTEM</text>
  <text x="700" y="55" class="subtitle">Complete Workflow - Raspberry Pi B3+</text>

  <!-- START -->
  <ellipse cx="700" cy="100" rx="80" ry="35" class="start-end"/>
  <text x="700" y="107" class="text">START</text>

  <!-- System Initialization -->
  <rect x="600" y="160" width="200" height="60" rx="5" class="process"/>
  <text x="700" y="185" class="text">System Initialization</text>
  <text x="700" y="205" class="text">GPIO Setup, Camera,</text>
  <text x="700" y="220" class="text">Sensors, LSC-6 Arm</text>

  <!-- Startup Sound -->
  <rect x="600" y="250" width="200" height="50" rx="5" class="action"/>
  <text x="700" y="272" class="text">Play Startup Sound</text>
  <text x="700" y="287" class="text">(3 Beeps)</text>

  <!-- Main Loop Start -->
  <rect x="600" y="330" width="200" height="50" rx="5" class="process"/>
  <text x="700" y="352" class="text">Start Main Loop</text>
  <text x="700" y="367" class="text">(Threaded Monitoring)</text>

  <!-- Three Parallel Processes -->
  <text x="250" y="430" class="subtitle" style="font-weight: bold;">Camera Thread</text>
  <text x="700" y="430" class="subtitle" style="font-weight: bold;">Sensor Thread</text>
  <text x="1150" y="430" class="subtitle" style="font-weight: bold;">Soil Thread</text>

  <!-- CAMERA THREAD -->
  <rect x="150" y="460" width="200" height="50" rx="5" class="sensor"/>
  <text x="250" y="482" class="text">Capture Camera</text>
  <text x="250" y="497" class="text">Frame (640x480)</text>

  <rect x="150" y="540" width="200" height="50" rx="5" class="process"/>
  <text x="250" y="562" class="text">YOLOv11 Disease</text>
  <text x="250" y="577" class="text">Detection</text>

  <path d="M 250 590 L 250 630" class="arrow"/>
  <polygon points="150,630 350,630 250,680" class="decision"/>
  <text x="250" y="650" class="text">Disease</text>
  <text x="250" y="665" class="text">Detected?</text>

  <!-- YES path -->
  <path d="M 150 655 L 50 655 L 50 750" class="arrow"/>
  <text x="35" y="650" class="label">YES</text>
  
  <rect x="0" y="750" width="160" height="60" rx="5" class="action"/>
  <text x="80" y="772" class="text">Log Detection</text>
  <text x="80" y="787" class="text">Count Diseases</text>
  <text x="80" y="802" class="text">Update Status</text>

  <rect x="0" y="840" width="160" height="50" rx="5" class="decision"/>
  <text x="80" y="862" class="text">Auto Mode</text>
  <text x="80" y="877" class="text">Enabled?</text>

  <path d="M 80 890 L 80 930" class="arrow"/>
  <text x="95" y="915" class="label">YES</text>
  
  <rect x="0" y="930" width="160" height="50" rx="5" class="action"/>
  <text x="80" y="952" class="text">Spray Fertilizer</text>
  <text x="80" y="967" class="text">(30 seconds)</text>

  <rect x="0" y="1010" width="160" height="50" rx="5" class="action"/>
  <text x="80" y="1032" class="text">UV Light Treatment</text>
  <text x="80" y="1047" class="text">(3 minutes)</text>

  <rect x="0" y="1090" width="160" height="40" rx="5" class="action"/>
  <text x="80" y="1115" class="text">Beep Confirmation</text>

  <!-- NO path from disease detection -->
  <path d="M 350 655 L 450 655 L 450 1150 L 250 1150" class="arrow"/>
  <text x="460" y="650" class="label">NO</text>

  <!-- Continue loop -->
  <path d="M 80 1130 L 80 1150 L 250 1150" class="arrow"/>
  <rect x="170" y="1130" width="160" height="40" rx="5" class="process"/>
  <text x="250" y="1155" class="text">Continue Monitoring</text>

  <path d="M 250 1170 L 250 1200 L 480 1200 L 480 460 L 350 460" class="arrow"/>

  <!-- SENSOR THREAD (Middle) -->
  <rect x="600" y="460" width="200" height="50" rx="5" class="sensor"/>
  <text x="700" y="477" class="text">PIR Motion Sensor</text>
  <text x="700" y="492" class="text">Read Every 0.5s</text>

  <path d="M 700 510 L 700 550" class="arrow"/>
  <polygon points="600,550 800,550 700,600" class="decision"/>
  <text x="700" y="570" class="text">Motion</text>
  <text x="700" y="585" class="text">Detected?</text>

  <path d="M 600 575 L 520 575 L 520 660" class="arrow"/>
  <text x="505" y="570" class="label">YES</text>
  
  <rect x="450" y="660" width="140" height="60" rx="5" class="action"/>
  <text x="520" y="677" class="text">Turn OFF</text>
  <text x="520" y="692" class="text">Relay Switch 2</text>
  <text x="520" y="707" class="text">Beep Alert</text>

  <path d="M 800 575 L 880 575 L 880 660" class="arrow"/>
  <text x="900" y="570" class="label">NO</text>
  
  <rect x="810" y="660" width="140" height="60" rx="5" class="action"/>
  <text x="880" y="682" class="text">Turn ON</text>
  <text x="880" y="697" class="text">Relay Switch 2</text>

  <path d="M 520 720 L 520 760 L 700 760" class="arrow"/>
  <path d="M 880 720 L 880 760 L 700 760" class="arrow"/>

  <!-- MQ2 Smoke Sensor -->
  <rect x="600" y="760" width="200" height="50" rx="5" class="sensor"/>
  <text x="700" y="777" class="text">MQ2 Smoke Sensor</text>
  <text x="700" y="792" class="text">Read Every 0.5s</text>

  <path d="M 700 810 L 700 850" class="arrow"/>
  <polygon points="600,850 800,850 700,900" class="decision"/>
  <text x="700" y="870" class="text">Smoke</text>
  <text x="700" y="885" class="text">Detected?</text>

  <path d="M 600 875 L 520 875 L 520 940" class="arrow"/>
  <text x="505" y="870" class="label">YES</text>
  
  <rect x="440" y="940" width="160" height="60" rx="5" class="action"/>
  <text x="520" y="957" class="text">🔥 FIRE ALARM!</text>
  <text x="520" y="972" class="text">Play Alarm Sound</text>
  <text x="520" y="987" class="text">(5 seconds)</text>

  <path d="M 800 875 L 860 875 L 860 970 L 700 970" class="arrow"/>
  <text x="875" y="870" class="label">NO</text>
  
  <path d="M 520 1000 L 520 1040 L 700 1040" class="arrow"/>
  <rect x="600" y="1020" width="200" height="40" rx="5" class="process"/>
  <text x="700" y="1045" class="text">Continue Monitoring</text>

  <path d="M 700 1060 L 700 1100 L 850 1100 L 850 460 L 800 460" class="arrow"/>

  <!-- SOIL THREAD (Right) -->
  <rect x="1050" y="460" width="200" height="50" rx="5" class="sensor"/>
  <text x="1150" y="482" class="text">Soil Moisture Check</text>
  <text x="1150" y="497" class="text">(Every 30 min)</text>

  <rect x="1050" y="540" width="200" height="60" rx="5" class="action"/>
  <text x="1150" y="557" class="text">Move Servo to 90°</text>
  <text x="1150" y="572" class="text">Insert Soil Probe</text>
  <text x="1150" y="587" class="text">Read ADS1115</text>

  <rect x="1050" y="630" width="200" height="50" rx="5" class="io"/>
  <text x="1150" y="652" class="text">Calculate Moisture %</text>
  <text x="1150" y="667" class="text">Update Status</text>

  <rect x="1050" y="710" width="200" height="50" rx="5" class="action"/>
  <text x="1150" y="732" class="text">Return Servo to 0°</text>
  <text x="1150" y="747" class="text">Retract Probe</text>

  <path d="M 1150 760 L 1150 800" class="arrow"/>
  <polygon points="1050,800 1250,800 1150,850" class="decision"/>
  <text x="1150" y="820" class="text">Moisture</text>
  <text x="1150" y="835" class="text">&lt; 30%?</text>

  <path d="M 1050 825 L 970 825 L 970 920" class="arrow"/>
  <text x="955" y="820" class="label">YES</text>
  
  <rect x="900" y="920" width="140" height="60" rx="5" class="action"/>
  <text x="970" y="937" class="text">Spray Water</text>
  <text x="970" y="952" class="text">(30 seconds)</text>
  <text x="970" y="967" class="text">Beep</text>

  <path d="M 1250 825 L 1330 825 L 1330 970 L 1150 970" class="arrow"/>
  <text x="1345" y="820" class="label">NO</text>
  
  <path d="M 970 980 L 970 1020 L 1150 1020" class="arrow"/>
  <rect x="1050" y="1000" width="200" height="40" rx="5" class="process"/>
  <text x="1150" y="1025" class="text">Wait 30 Minutes</text>

  <path d="M 1150 1040 L 1150 1080 L 1290 1080 L 1290 460 L 1250 460" class="arrow"/>

  <!-- WEB INTERFACE -->
  <rect x="550" y="1230" width="300" height="50" rx="5" class="io"/>
  <text x="700" y="1247" class="text" style="font-size: 15px; font-weight: bold;">WEB INTERFACE (Flask)</text>
  <text x="700" y="1265" class="text">Port 5000 - Real-time Dashboard</text>

  <!-- Web Interface Features -->
  <rect x="100" y="1310" width="180" height="100" rx="5" class="process"/>
  <text x="190" y="1330" class="text" style="font-weight: bold;">Live Video Feed</text>
  <text x="190" y="1350" class="text">- Camera Stream</text>
  <text x="190" y="1365" class="text">- Disease Annotations</text>
  <text x="190" y="1380" class="text">- Detection Boxes</text>
  <text x="190" y="1395" class="text">- Confidence Scores</text>

  <rect x="310" y="1310" width="180" height="100" rx="5" class="process"/>
  <text x="400" y="1330" class="text" style="font-weight: bold;">System Status</text>
  <text x="400" y="1350" class="text">- Soil Moisture</text>
  <text x="400" y="1365" class="text">- Relay States</text>
  <text x="400" y="1380" class="text">- Sensor Readings</text>
  <text x="400" y="1395" class="text">- LSC-6 Positions</text>

  <rect x="520" y="1310" width="180" height="100" rx="5" class="process"/>
  <text x="610" y="1330" class="text" style="font-weight: bold;">Manual Controls</text>
  <text x="610" y="1350" class="text">- Fertilizer Spray</text>
  <text x="610" y="1365" class="text">- Water Spray</text>
  <text x="610" y="1380" class="text">- UV Light</text>
  <text x="610" y="1395" class="text">- Servo Control</text>

  <rect x="730" y="1310" width="180" height="100" rx="5" class="process"/>
  <text x="820" y="1330" class="text" style="font-weight: bold;">LSC-6 Arm Control</text>
  <text x="820" y="1350" class="text">- 6 Servo Sliders</text>
  <text x="820" y="1365" class="text">- Position Feedback</text>
  <text x="820" y="1380" class="text">- Speed Control</text>
  <text x="820" y="1395" class="text">- Reset Position</text>

  <rect x="940" y="1310" width="180" height="100" rx="5" class="process"/>
  <text x="1030" y="1330" class="text" style="font-weight: bold;">AI Analysis</text>
  <text x="1030" y="1350" class="text">- Gemini API</text>
  <text x="1030" y="1365" class="text">- Disease ID</text>
  <text x="1030" y="1380" class="text">- Treatment Tips</text>
  <text x="1030" y="1395" class="text">- Prevention</text>

  <rect x="1150" y="1310" width="180" height="100" rx="5" class="process"/>
  <text x="1240" y="1330" class="text" style="font-weight: bold;">Reports & Logs</text>
  <text x="1240" y="1350" class="text">- Daily Reports</text>
  <text x="1240" y="1365" class="text">- System Logs</text>
  <text x="1240" y="1380" class="text">- Detection History</text>
  <text x="1240" y="1395" class="text">- Export JSON</text>

  <!-- Arrows from web interface -->
  <path d="M 700 1280 L 190 1310" class="arrow"/>
  <path d="M 700 1280 L 400 1310" class="arrow"/>
  <path d="M 700 1280 L 610 1310" class="arrow"/>
  <path d="M 700 1280 L 820 1310" class="arrow"/>
  <path d="M 700 1280 L 1030 1310" class="arrow"/>
  <path d="M 700 1280 L 1240 1310" class="arrow"/>

  <!-- Hardware Summary -->
  <rect x="100" y="1450" width="600" height="180" rx="5" style="fill: #E8F5E9; stroke: #2E7D32; stroke-width: 2;"/>
  <text x="400" y="1475" style="font-size: 16px; font-weight: bold; fill: #1B5E20;">HARDWARE COMPONENTS</text>
  
  <text x="120" y="1500" class="label" style="font-weight: bold;">Sensors:</text>
  <text x="120" y="1520" class="label">• Camera (USB/CSI)</text>
  <text x="120" y="1537" class="label">• ADS1115 (Soil Moisture)</text>
  <text x="120" y="1554" class="label">• PIR Motion Sensor</text>
  <text x="120" y="1571" class="label">• MQ2 Smoke Detector</text>

  <text x="320" y="1500" class="label" style="font-weight: bold;">Actuators:</text>
  <text x="320" y="1520" class="label">• 4x Relay Module</text>
  <text x="320" y="1537" class="label">• 2x Servo Motors</text>
  <text x="320" y="1554" class="label">• Piezo Buzzer</text>
  <text x="320" y="1571" class="label">• LSC-6 Robotic Arm</text>

  <text x="520" y="1500" class="label" style="font-weight: bold;">Outputs:</text>
  <text x="520" y="1520" class="label">• Fertilizer Pump</text>
  <text x="520" y="1537" class="label">• Water Pump</text>
  <text x="520" y="1554" class="label">• UV Light</text>
  <text x="520" y="1571" class="label">• Box Mechanism</text>
  
  <text x="120" y="1595" class="label" style="font-weight: bold;">AI Models:</text>
  <text x="120" y="1615" class="label">• YOLOv11 (Local Detection) • Google Gemini 1.5 (Cloud Analysis)</text>

  <!-- Features Summary -->
  <rect x="730" y="1450" width="570" height="180" rx="5" style="fill: #E3F2FD; stroke: #1565C0; stroke-width: 2;"/>
  <text x="1015" y="1475" style="font-size: 16px; font-weight: bold; fill: #0D47A1;">KEY FEATURES</text>
  
  <text x="750" y="1505" class="label">✓ Real-time disease detection with YOLOv11</text>
  <text x="750" y="1525" class="label">✓ Automated treatment (fertilizer + UV light)</text>
  <text x="750" y="1545" class="label">✓ Smart soil moisture monitoring (30-min intervals)</text>
  <text x="750" y="1565" class="label">✓ Motion-triggered security system (PIR sensor)</text>
  <text x="750" y="1585" class="label">✓ Fire/smoke detection with alarm</text>
  <text x="750" y="1605" class="label">✓ 6-DOF robotic arm control (LSC-6)</text>

  <!-- Decision Flow Legend -->
  <rect x="100" y="1670" width="400" height="160" rx="5" style="fill: #FFF3E0; stroke: #E65100; stroke-width: 2;"/>
  <text x="300" y="1695" style="font-size: 15px; font-weight: bold; fill: #E65100;">AUTOMATION LOGIC</text>
  
  <text x="120" y="1720" class="label" style="font-weight: bold;">1. Disease Detection Flow:</text>
  <text x="130" y="1740" class="label">Camera → YOLOv11 → If disease → Auto spray + UV</text>
  
  <text x="120" y="1765" class="label" style="font-weight: bold;">2. Soil Moisture Flow:</text>
  <text x="130" y="1785" class="label">Servo insert → Read sensor → If &lt;30% → Water spray</text>
  
  <text x="120" y="1810" class="label" style="font-weight: bold;">3. Security Flow:</text>
  <text x="130" y="1830" class="label">PIR motion → Disable relay • MQ2 smoke → Sound alarm</text>

  <!-- System States -->
  <rect x="530" y="1670" width="400" height="160" rx="5" style="fill: #F3E5F5; stroke: #6A1B9A; stroke-width: 2;"/>
  <text x="730" y="1695" style="font-size: 15px; font-weight: bold; fill: #6A1B9A;">OPERATING MODES</text>
  
  <text x="550" y="1725" class="label" style="font-weight: bold;">AUTO MODE (Default):</text>
  <text x="560" y="1745" class="label">• Automatic disease treatment</text>
  <text x="560" y="1765" class="label">• Automatic soil watering</text>
  <text x="560" y="1785" class="label">• Background sensor monitoring</text>
  
  <text x="550" y="1810" class="label" style="font-weight: bold;">MANUAL MODE:</text>
  <text x="560" y="1830" class="label">• Web dashboard control only</text>

  <!-- Performance Metrics -->
  <rect x="960" y="1670" width="340" height="160" rx="5" style="fill: #FCE4EC; stroke: #B71C1C; stroke-width: 2;"/>
  <text x="1130" y="1695" style="font-size: 15px; font-weight: bold; fill: #B71C1C;">DAILY TRACKING</text>
  
  <text x="980" y="1725" class="label">📊 Total detections count</text>
  <text x="980" y="1745" class="label">🦠 Unique diseases identified</text>
  <text x="980" y="1765" class="label">💊 Treatments applied</text>
  <text x="980" y="1785" class="label">👤 Motion events logged</text>
  <text x="980" y="1805" class="label">🔥 Smoke alerts triggered</text>
  <text x="980" y="1825" class="label">📥 Exportable JSON reports</text>

  <!-- Communication -->
  <rect x="100" y="1870" width="1200" height="80" rx="5" style="fill: #E0F2F1; stroke: #006064; stroke-width: 2;"/>
  <text x="700" y="1895" style="font-size: 15px; font-weight: bold; fill: #00695C;">SYSTEM COMMUNICATION</text>
  
  <text x="120" y="1920" class="label">🌐 Flask Web Server (Port 5000) → REST API Endpoints</text>
  <text x="120" y="1940" class="label">📡 I2C Bus → ADS1115 Soil Sensor • USB Serial → LSC-6 Arm Controller • GPIO → All Other Peripherals</text>

  <!-- END -->
  <path d="M 700 1950 L 700 2000" class="arrow"/>
  <ellipse cx="700" cy="2050" rx="100" ry="35" class="start-end"/>
  <text x="700" y="2050" class="text">SYSTEM RUNNING</text>
  <text x="700" y="2065" class="text">(Continuous Loop)</text>

  <!-- Footer -->
  <text x="700" y="2120" style="fill: #666; font-size: 11px; text-anchor: middle;">Press Ctrl+C to stop system • GPIO cleanup on exit</text>
  <text x="700" y="2140" style="fill: #1976D2; font-size: 12px; font-weight: bold; text-anchor: middle;">Raspberry Pi B3+ • Python 3 • Flask • OpenCV • YOLOv11 • Ultralytics</text>
</svg>
